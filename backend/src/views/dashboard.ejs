<%- include('partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h2>Server Resource Usage</h2>
    <div style="color: var(--text-muted);">Last updated: <span id="last-updated">Just now</span></div>
</div>

<div class="grid grid-4">
    <div class="glass-card">
        <div style="color: var(--text-muted); margin-bottom: 0.5rem;">CPU Usage</div>
        <div id="cpu-text" style="font-size: 2rem; font-weight: 700; color: var(--accent);">--%</div>
    </div>
    <div class="glass-card">
        <div style="color: var(--text-muted); margin-bottom: 0.5rem;">Memory Usage</div>
        <div id="mem-text" style="font-size: 2rem; font-weight: 700; color: var(--accent);">--GB / --GB</div>
    </div>
    <div class="glass-card">
        <div style="color: var(--text-muted); margin-bottom: 0.5rem;">Active Connections</div>
        <div id="conn-text" style="font-size: 2rem; font-weight: 700; color: var(--accent);">--</div>
    </div>
    <div class="glass-card">
        <div style="color: var(--text-muted); margin-bottom: 0.5rem;">Uptime</div>
        <div id="uptime-text" style="font-size: 1.5rem; font-weight: 700; color: var(--success);">--d --h --m</div>
    </div>
</div>

<div class="grid grid-2" style="margin-top: 2rem; grid-template-columns: 1fr 1fr; gap: 2rem;">
    <div class="glass-card">
        <h3 style="margin-bottom: 1rem;">Server Load (Live)</h3>
        <div style="width: 100%; height: 300px;">
            <canvas id="serverChart"></canvas>
        </div>
    </div>
    <div class="glass-card">
        <h3 style="margin-bottom: 1rem;">Database Stats</h3>
        <div id="db-state" style="margin-bottom: 1rem; font-weight: bold; color: var(--text-muted);">State: Connecting...</div>
        <div style="width: 100%; height: 260px;">
            <canvas id="dbChart"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const serverCtx = document.getElementById('serverChart').getContext('2d');
    const dbCtx = document.getElementById('dbChart').getContext('2d');

    const serverChart = new Chart(serverCtx, {
        type: 'line',
        data: {
            labels: [],
            datasets: [
                { 
                    label: 'CPU Usage (%)', 
                    borderColor: '#1788c3', 
                    backgroundColor: 'rgba(23, 136, 195, 0.2)', 
                    data: [], 
                    tension: 0, 
                    pointRadius: 0,
                    borderWidth: 1.5,
                    fill: true 
                },
                { 
                    label: 'Memory (GB)', 
                    borderColor: '#8e44ad', 
                    backgroundColor: 'rgba(142, 68, 173, 0.2)', 
                    data: [], 
                    tension: 0, 
                    pointRadius: 0,
                    borderWidth: 1.5,
                    fill: true 
                }
            ]
        },
        options: { 
            responsive: true, 
            maintainAspectRatio: false, 
            animation: false, 
            layout: { padding: 0 },
            scales: { 
                y: { 
                    beginAtZero: true, 
                    suggestedMax: 100,
                    grid: { color: 'rgba(255, 255, 255, 0.1)', drawBorder: true },
                    ticks: { maxTicksLimit: 5, color: '#888' }
                },
                x: { 
                    grid: { color: 'rgba(255, 255, 255, 0.1)', drawBorder: true },
                    ticks: { maxTicksLimit: 10, color: '#888', maxRotation: 0 }
                }
            },
            plugins: { 
                legend: { position: 'top', labels: { color: '#ccc', usePointStyle: true, boxWidth: 8 } },
                tooltip: { intersect: false, mode: 'index' }
            }
        }
    });

    const dbChart = new Chart(dbCtx, {
        type: 'bar',
        data: {
            labels: ['Collections', 'Objects (k)', 'Data Size (MB)'],
            datasets: [{ label: 'MongoDB Metrics', backgroundColor: ['#2ecc71', '#3498db', '#f1c40f'], data: [0, 0, 0], borderWidth: 1, borderColor: '#fff' }]
        },
        options: { 
            responsive: true, 
            maintainAspectRatio: false,
            scales: { 
                y: { beginAtZero: true, grid: { color: 'rgba(255, 255, 255, 0.1)' }, ticks: { color: '#888' } },
                x: { grid: { display: false }, ticks: { color: '#ccc' } }
            },
            plugins: { legend: { display: false } }
        }
    });

    async function fetchMetrics() {
        try {
            const res = await fetch('/admin/server-dashboard/metrics');
            const data = await res.json();

            document.getElementById('cpu-text').innerText = data.cpuUsage + '%';
            document.getElementById('mem-text').innerText = data.memoryUsage + 'GB / ' + data.memoryTotal + 'GB';
            document.getElementById('conn-text').innerText = data.activeConnections;
            document.getElementById('uptime-text').innerText = data.uptime;
            document.getElementById('last-updated').innerText = data.timestamp;

            const timeLabel = data.timestamp.split(' ')[0]; 
            if (serverChart.data.labels.length > 20) {
                serverChart.data.labels.shift();
                serverChart.data.datasets[0].data.shift();
                serverChart.data.datasets[1].data.shift();
            }
            serverChart.data.labels.push(timeLabel);
            serverChart.data.datasets[0].data.push(data.cpuUsage);
            serverChart.data.datasets[1].data.push(data.memoryUsage);
            serverChart.update();

            document.getElementById('db-state').innerText = 'State: ' + data.dbState;
            document.getElementById('db-state').style.color = data.dbState === 'Connected' ? '#2ecc71' : '#e74c3c';
            dbChart.data.datasets[0].data = [
                data.dbStats.collections,
                (data.dbStats.objects / 1000).toFixed(2),
                data.dbStats.dataSize
            ];
            dbChart.update();
            
        } catch (err) {
            console.error('Failed to fetch metrics', err);
        }
    }

    setInterval(fetchMetrics, 3000);
    fetchMetrics(); 
</script>

<%- include('partials/footer') %>
